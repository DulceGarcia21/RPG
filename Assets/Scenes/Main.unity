  m_Script: {fileID: 11500000, guid: 30a2b63cd30c437488129f85a746080c, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::NPC
  cajaDialogo: {fileID: 1706009079}
  textoTMP: {fileID: 224438150}
  velocidadEscritura: 0.03
  dialogos:
  - "Tactus: \xA1Ah, Segador! Qu\xE9 buen momento para cruzarnos. Estaba juntando algo de madera para las fogatas del castillo."
  - "Tactus: Estaba por esa zona de all\xE1 arriba y me percat\xE9 de esa cueva que tienes justo en frente."
  - "Tactus: Ten los ojos bien abiertos si vas a entrar... Jurar\xEDa haber escuchado ruidos y parece que hay algo acechando all\xE1 adentro."
